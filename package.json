{
	"name": "knitto-backend-boilerplate-ts",
	"version": "0.0.0",
	"description": "Production-ready TypeScript REST API Boilerplate untuk Knitto Textile - Built with Express.js, MySQL, and Domain-Driven Design",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"private": true,
	"packageManager": "pnpm@11.17.0",
	"engines": {
		"node": "24.18.0",
		"pnpm": "11.17.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/knittotextile/rest-boilerplate-ts.git"
	},
	"bugs": {
		"url": "https://github.com/knittotextile/rest-boilerplate-ts/issues",
		"email": "it01.knitto@gmail.com"
	},
	"homepage": "https://github.com/knittotextile/rest-boilerplate-ts#readme",
	"scripts": {
		"preinstall": "node scripts/check-engines.mjs",
		"prepare": "husky || true",
		"build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npx tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"start:docker": "docker build -t knitto_boiler_plate:latest --build-arg github_token=${GITHUB_TOKEN} . && docker compose up -d",
		"stop:docker": "docker compose down",
		"dev": "tsx watch ./src/index.ts",
		"dev:debug": "DEBUG=* tsx watch ./src/index.ts",
		"lint:openapi": "spectral lint docs/openapi/openapi.yaml --ruleset docs/openapi/.spectral.yaml",
		"lint": "eslint --fix \"src/app/http/**/*.ts\"",
		"lint:fix": "eslint --fix \"src/app/http/**/*.ts\"",
		"type-check": "tsc --noEmit -p tsconfig.json",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	},
	"keywords": [
		"typescript",
		"express",
		"rest-api",
		"boilerplate",
		"mysql",
		"domain-driven-design",
		"knitto",
		"backend",
		"nodejs",
		"valibot",
		"production-ready"
	],
	"author": {
		"name": "Knitto Textile IT Team",
		"email": "it01.knitto@gmail.com",
		"url": "https://github.com/knittotextile"
	},
	"license": "UNLICENSED",
	"dependencies": {
		"@knittotextile/knitto-core-backend": "~0.4.1",
		"@knittotextile/knitto-http": "~1.0.0",
		"@knittotextile/knitto-mysql": "~0.3.1",
		"@knittotextile/knitto-rabbitmq": "~2.0.0",
		"@scalar/express-api-reference": "~0.8.48",
		"bcryptjs": "~2.4.3",
		"dotenv": "~16.4.5",
		"jsonwebtoken": "~9.0.3",
		"minio": "^8.0.7",
		"module-alias": "~2.2.3",
		"moment": "^2.30.1",
		"openai": "^7.17.0",
		"socket.io": "4",
		"tslib": "~2.8.1",
		"valibot": "^1.4.2",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@stoplight/spectral-cli": "^6.16.2",
		"@types/bcryptjs": "~2.4.2",
		"@types/jest": "~30.0.0",
		"@types/jsonwebtoken": "~9.0.10",
		"@types/module-alias": "~2.0.4",
		"@types/node": "~24.13.0",
		"@typescript-eslint/eslint-plugin": "^8.53.1",
		"@typescript-eslint/parser": "^8.53.1",
		"eslint": "~9.39.2",
		"husky": "~9.1.1",
		"jest": "~30.2.0",
		"ts-jest": "^29.4.6",
		"tsx": "~4.23.0",
		"typescript": "~5.5.4",
		"typescript-eslint": "^8.65.0"
	},
	"_aliases": {
		"@": "./src/",
		"@http": "./src/app/http/",
		"@httpController": "./src/app/http/controller/",
		"@repositories": "./src/repositories/",
		"@libs": "./src/libs/",
		"@services": "./src/services/"
	}
}
