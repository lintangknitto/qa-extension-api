# Salin ke .cursor/automation/config.env (jangan commit secrets)
# Atau export di shell server sebelum menjalankan pipeline

# Wajib untuk agent headless
CURSOR_API_KEY=

# GitHub — assign PR setelah review pass
GITHUB_ASSIGNEE=your-github-username

# Branch epic dibuat dari branch ini jika belum ada
EPIC_BASE_BRANCH=main

# Model Cursor agent (opsional, default inherit)
# AGENT_MODEL=composer-2.5

# Timeout per stage agent (detik)
STAGE_TIMEOUT_SEC=3600

# Heal-agent — retry otomatis saat stage gagal
HEAL_MAX_RETRIES=3
HEAL_MAX_RETRIES_GIT=2
HEAL_MAX_RETRIES_PLAN=2
HEAL_MAX_RETRIES_DEV=3
HEAL_MAX_RETRIES_PR=2
HEAL_MAX_RETRIES_REVIEW=2

# Babysit loop — PR merge-ready (komentar / CI / conflict)
BABYSIT_MAX_RETRIES=5
BABYSIT_CI_POLL_INTERVAL_MS=30000
BABYSIT_CI_POLL_TIMEOUT_MS=1800000

# Fix pipeline — bugfix di epic dari GitHub issue
FIX_MAX_RETRIES=3
FIX_MAX_RETRIES_GIT=2
FIX_MAX_RETRIES_FIX=3
FIX_MAX_RETRIES_PR=2
FIX_MAX_RETRIES_REVIEW=2
