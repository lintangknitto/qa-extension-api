#Applicatiion
APP_PORT_HTTP=8000
OPENAPI_DOCS_ENABLED=false # set ke true untuk enable openapi docs
TRACE_IN_RESPONSE=true #set false untuk disable trace in response
NODE_ENV=development
APP_NAME=kat-rest-boiler-plate
#lihat di jenkins backend yang sudah ada
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
APP_SECRET_KEY=

# Bootstrap satu-satunya admin pertama (jangan simpan password di file ini).
# Isi hanya saat menjalankan pnpm db:bootstrap-admin, lalu hapus nilainya.
ALLOW_ADMIN_BOOTSTRAP=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# DEBUG
APP_LOG_LEVEL=debug # di production set ke info supaya tidak terlalu banyak logs
NODE_ENV=development # di production set ke production
DEBUG_QUERY=false # di production set ke true
DEBUG_SINGLE_FLIGHT=false #set true, jika perlu debugging double request

#Database
DB_HOST_MYSQL=
DB_NAME_MYSQL=
DB_USER_MYSQL=
DB_PASS_MYSQL=
DB_PORT_MYSQL=

#rabbit
RABBITMQ_URL=
RABBITMQ_EXCHANGE=

# Test session recorder (isi RECORDING_FEATURE_ENABLED=true untuk mengaktifkan validasi startup)
RECORDING_FEATURE_ENABLED=false

# OpenAI-compatible provider (JANGAN commit nilai asli)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=qa-automation
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_OUTPUT_TOKENS=4000

# MinIO standalone (service terpisah, JANGAN commit nilai asli)
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=qa-recording-artifacts
# Host MinIO yang dijangkau browser tester (bucket public read+write, tanpa signature), mis. http://192.168.20.2:9000
MINIO_PUBLIC_BASE_URL=

# Batas recording
RECORDING_UPLOAD_MAX_BYTES=10485760
RECORDING_PRESIGN_EXPIRY_SECONDS=900
RECORDING_NETWORK_BODY_MAX_BYTES=262144
RECORDING_ARTIFACT_CONTENT_TYPES=image/png,image/jpeg,image/webp,application/json,text/plain

# Level user yang boleh mengelola master project
PROJECT_ADMIN_LEVELS=ADMIN,QA,SUPERADMIN
POSTGRES_PASSWORD=
EMBEDDING_API_KEY=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
# Opsional: kosongkan agar UID dibaca dari dashboard program / auto-discover datasource sehat
GRAFANA_LOKI_UID=
GRAFANA_PROMETHEUS_UID=
